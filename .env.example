# ---------- Postgres container ----------
POSTGRES_VERSION = 16
POSTGRES_USER = app
POSTGRES_PASSWORD = change_me_strong
POSTGRES_DB = discord_link_spotify_api

# ---------- Image ----------
IMAGE_NAME = discord_link_spotify_api
IMAGE_TAG = latest

# ---------- Ports ----------
CONTAINER_PORT = 8080
APP_PORT = 8080

# ---------- Server ----------
BASE_URL = https://api.example.com
API_KEY = change_me_api_key

# ---------- OAuth ----------
DISCORD_CLIENT_ID =
DISCORD_CLIENT_SECRET =
SPOTIFY_CLIENT_ID =
SPOTIFY_CLIENT_SECRET =

# ---------- If dont use container ----------
BIND_ADDR = 0.0.0.0:8080
DATABASE_URL = postgres://user:password@localhost:5432/discord_link_spotify_api
